{
  "name": "@vplayer/core",
  "version": "0.1.3",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divyam234/vplayer.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/store": "^0.8.0",
    "dashjs": "^5.1.1",
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
