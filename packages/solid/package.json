{
  "name": "@vplayer/solid",
  "version": "0.0.0",
  "private": false,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./player.css": "./src/player.css"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tailwindcss -i ./src/player.css -o ./dist/player.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ark-ui/solid": "5.36.2",
    "@tanstack/store": "^0.8.0",
    "@vplayer/core": "workspace:*",
    "@vplayer/framework": "workspace:*",
    "clsx": "^2.1.1",
    "iconify-icon": "^2.3.0",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.6"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  }
}
