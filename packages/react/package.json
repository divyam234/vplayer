{
  "name": "@vplayer/react",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./player.css": "./src/player.css"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.build.json && vite build && tailwindcss -i ./src/player.css -o ./dist/player.css --minify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.3.0 || >=19.0.0",
    "react-dom": ">=18.3.0 || >=19.0.0"
  },
  "dependencies": {
    "@react-aria/interactions": "^3.25.6",
    "@tanstack/react-store": "^0.8.0",
    "@tanstack/store": "^0.8.0",
    "@vplayer/core": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.13.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
