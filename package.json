{
  "name": "vplayer-workspace",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/react",
    "apps/playground"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@vplayer/playground",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "typecheck": "turbo run typecheck",
    "lint": "./node_modules/.bin/oxlint",
    "lint:fix": "./node_modules/.bin/oxlint --fix",
    "format": "./node_modules/.bin/oxfmt",
    "format:check": "./node_modules/.bin/oxfmt --check",
    "test": "turbo run test",
    "test:all": "bun run typecheck && bun run test && bun run build",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build:packages && changeset publish",
    "dev:playground": "turbo run dev --filter=@vplayer/playground"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.14"
}
