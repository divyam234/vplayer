{
  "name": "vplayer-workspace",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/react",
    "apps/playground"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@vplayer/playground",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "typecheck": "turbo run typecheck",
    "lint": "./node_modules/.bin/oxlint",
    "lint:fix": "./node_modules/.bin/oxlint --fix",
    "format": "./node_modules/.bin/oxfmt",
    "format:check": "./node_modules/.bin/oxfmt --check",
    "test": "turbo run test",
    "test:e2e": "./node_modules/.bin/playwright test",
    "test:all": "bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build:packages && changeset publish",
    "dev:playground": "turbo run dev --filter=@vplayer/playground"
  },
  "dependencies": {
    "@ark-ui/react": "5.36.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.10.9",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.14"
}
