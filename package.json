{
  "name": "vplayer-workspace",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/react",
    "apps/docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @vplayer/docs",
    "build": "npm run build --workspace @vplayer/core && npm run build --workspace @vplayer/react && npm run build --workspace @vplayer/docs",
    "typecheck": "npm run typecheck --workspace @vplayer/core && npm run typecheck --workspace @vplayer/react && npm run typecheck --workspace @vplayer/docs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "dev:docs": "npm run dev --workspace @vplayer/docs"
  },
  "dependencies": {
    "@ark-ui/react": "5.36.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.1.8"
  },
  "packageManager": "npm@10.9.2"
}
